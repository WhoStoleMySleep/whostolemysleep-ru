POSTGRES_PRISMA_URL="postgres://user:password@host/db?pgbouncer=true&connect_timeout=15&sslmode=require"
POSTGRES_URL_NON_POOLING="postgres://user:password@host/db?sslmode=require"
EMAIL_PASSWORD="your_app_password"
ADMIN_JWT_SECRET="long_random_string"      # signs the admin cookie
ADMIN_PASSWORD_HASH="$2b$10$..."           # bcrypt hash of the admin password
EMAIL="your@email.com"
# token for the external publisher (NuxtPublish) — generate: openssl rand -base64 32
PUBLISH_TOKEN="your_publish_token"
# ISR cache invalidation on Vercel: the same value is needed at build time (it lands
# in .prerender-config.json) and at runtime — generate: openssl rand -hex 16
ISR_BYPASS_TOKEN="32_hex_chars"
NUXT_PUBLIC_SITE_URL="https://whostolemysleep.ru"
NUXT_PUBLIC_CONTACT_FORM=true
# Sentry: the DSN is public, it ships in the client bundle — it is not a secret
NUXT_PUBLIC_SENTRY_DSN="https://<key>@<org>.ingest.us.sentry.io/<project>"
# source map upload at build time; without these the traces show minified code
SENTRY_ORG="whostolemysleep"
SENTRY_PROJECT="your_project_slug"
SENTRY_AUTH_TOKEN="sntrys_..."
